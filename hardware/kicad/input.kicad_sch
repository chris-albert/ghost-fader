(text "J1 ring-normal contact: shorted to the ring (and so to U1 In-) with no plug,\nopen with any plug. Reads low when empty, high with TS or TRS plugged in.\n100k, not 1M: the ISO7762 input leaks up to 10 uA, and the pin must reach 0.7 x 5 V." (exclude_from_sim no) (at 63.5 85.09 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "6b354473-11fa-4717-bd68-b113bde8143a"))
(global_label "SENSE_R" (shape output) (at 55.88 119.38 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left)) (uuid "727324a8-a566-4819-8ac9-a5d3090d4586") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 55.88 119.38 0) (effects (font (size 1.27 1.27)) (hide yes))))
