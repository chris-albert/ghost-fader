(global_label "SENSE_R" (shape output) (at 48.26 152.4 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left)) (uuid "94dd79a6-e599-451a-84e1-34932f528c2d") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 48.26 152.4 0) (effects (font (size 1.27 1.27)) (hide yes))))
(text "J2 ring-normal contact: shorted to the ring (and so to U2 In-) with no plug,\nopen with any plug. Reads low when empty, high with TS or TRS plugged in.\n100k, not 1M: the ISO7762 input leaks up to 10 uA, and the pin must reach 0.7 x 5 V." (exclude_from_sim no) (at 63.5 151.13 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "62419269-47cc-41d5-91da-a5b1886ed7f0"))
(text "Balanced inputs. A TS plug grounds the ring, so unbalanced sources need no switch.\nTHAT 1246 = -6 dB, so +22 dBu peak (9.75 Vrms) becomes 4.9 Vrms, inside the PGA2310 9.5 Vrms full scale.\n100 pF C0G on every tip and ring shunts RF to ground. Tip-normal grounded: an empty input is silent, not noisy." (exclude_from_sim no) (at 33.02 35.56 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "5faa7abf-a8d9-45b2-a130-419f9305ec70"))
(text "Bypass, one per supply pin, within 5 mm of U1 / U2. C40, C41 bulk for the input side." (exclude_from_sim no) (at 200.66 45.72 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "19329c65-3b1e-406b-b2ad-37fbabb1279f"))
