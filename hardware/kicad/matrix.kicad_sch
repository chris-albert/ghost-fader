(label "R_SUM" (at 162.56 132.08 180) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "3b78db21-7f28-46c6-9e4c-44758633a988"))
(global_label "R_OUT_SE" (shape output) (at 198.12 129.54 0) (fields_autoplaced yes) (effects (font (size 1.27 1.27)) (justify left)) (uuid "852e3e56-813b-4660-9e15-4ca064920cd6") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 198.12 129.54 0) (effects (font (size 1.27 1.27)) (hide yes))))
(text "Summers: two 10k resistors into the + input make a passive 1/2 mix; the non-inverting x2 stage restores unity.\nWhen one path is muted its PGA output sits at 0 V, so the other still comes through at unity." (exclude_from_sim no) (at 147.32 152.4 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "16c4deb5-4762-4864-9c8d-8ac8f6c25a94"))
(text "Bypass, one per supply pin: U3 / U4 VA+, VA-, VD+; U5 V+, V-. C14 bulk on the +5VA logic rail beside U3." (exclude_from_sim no) (at 210.82 96.52 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "efe51397-b5b7-47ff-8fba-9c5dd8799732"))
